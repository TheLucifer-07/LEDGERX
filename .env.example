# Copy to .env (git-ignored). Used by the scripts in ./scripts and by docker-compose.yml.
# Administrator connection (a superuser; the Docker image creates "postgres")
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
# Database that `make test` / `make db-reset` (re)create
LEDGERX_DB=ledgerx
# Passwords for the two application roles (bootstrap sets them; change for anything non-local)
MIGRATOR_PASSWORD=ledgerx_migrator_dev
RUNTIME_PASSWORD=ledgerx_runtime_dev
